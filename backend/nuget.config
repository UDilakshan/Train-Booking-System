<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins package restore to just nuget.org for this project. The machine this was built on has
    an additional authenticated organization feed ("Optimo Feed") registered globally, which is
    unreachable/unauthorized in this context and was making every restore hang for minutes before
    failing over — irrelevant to this project and not something a clone of this repo should
    depend on anyway.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
