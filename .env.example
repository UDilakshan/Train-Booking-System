# Copy to .env and adjust before running `docker compose up`.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=railway_reservation
MYSQL_USER=railway
MYSQL_PASSWORD=railway

# Generate a long random string for production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string-in-production-min-32-chars
JWT_EXPIRES_IN_MINUTES=480

CORS_ORIGIN=http://localhost:3000

# Used once by the seed step on first run to create the admin user.
SEED_ADMIN_EMAIL=admin@railway.lk
SEED_ADMIN_PASSWORD=ChangeMe123!
